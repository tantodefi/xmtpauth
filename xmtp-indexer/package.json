{
  "name": "squid-evm-template",
  "private": true,
  "scripts": {
    "build": "rm -rf lib && tsc",
    "serve": "squid-graphql-server",
    "start": "node -r dotenv/config lib/main.js",
    "serve:production": "squid-graphql-server --port ${PORT:-4350}",
    "processor": "node -r dotenv/config lib/main.js",
    "dev": "concurrently \"npm run processor\" \"npm run serve\""
  },
  "dependencies": {
    "@subsquid/evm-abi": "^0.3.0",
    "@subsquid/evm-processor": "^1.19.1",
    "@subsquid/graphql-server": "^4.6.0",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "^1.5.1",
    "dotenv": "^16.4.5",
    "graphql-request": "^7.2.0",
    "pg": "^8.12.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@subsquid/evm-typegen": "^4.2.0",
    "@subsquid/typeorm-codegen": "^2.0.1",
    "@types/node": "^20.14.8",
    "concurrently": "^8.2.2",
    "typescript": "~5.5.2"
  }
}
