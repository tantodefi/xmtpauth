{
  "$schema": "https://cdn.subsquid.io/schemas/commands.json",
  "commands": {
    "clean": {
      "description": "delete all build artifacts",
      "cmd": ["npx", "--yes", "rimraf", "lib"]
    },
    "build": {
      "description": "build the squid project",
      "deps": ["clean"],
      "cmd": ["npx", "@subsquid/typeorm-codegen", "&&", "rm", "-rf", "lib", "&&", "tsc"]
    },
    "codegen": {
      "description": "generate TypeORM entities from the schema file",
      "cmd": ["npx", "@subsquid/typeorm-codegen"]
    },
    "migration:apply": {
      "description": "apply the DB migrations",
      "cmd": ["npx", "squid-typeorm-migration", "apply"]
    },
    "migration:generate": {
      "description": "generate a DB migration matching the TypeORM entities",
      "cmd": ["npx", "squid-typeorm-migration", "generate"]
    },
    "migration:clean": {
      "description": "clean the migrations folder",
      "cmd": ["npx", "--yes", "rimraf", "db/migrations/*.js"]
    },
    "process:prod": {
      "description": "run the squid processor (production)",
      "cmd": ["node", "-r", "dotenv/config", "lib/main.js"]
    },
    "serve:prod": {
      "description": "start the GraphQL API server with caching and limits",
      "cmd": ["npx", "@subsquid/graphql-server", "--dumb-cache", "in-memory", "--dumb-cache-ttl", "1000", "--dumb-cache-size", "100", "--dumb-cache-max-age", "1000"]
    }
  }
}
