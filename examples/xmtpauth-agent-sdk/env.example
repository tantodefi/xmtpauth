# XMTP Configuration (using agent-sdk environment variables)
XMTP_WALLET_KEY=0x...                          # Agent's private key
XMTP_DB_ENCRYPTION_KEY=...                     # Database encryption key  
XMTP_ENV=dev                                   # dev, production
XMTP_DB_PATH=.data/xmtp                       # Optional: database path (in-memory if not set)
XMTP_FORCE_DEBUG=false                        # Enable debug logging
XMTP_FORCE_REVOKE_INSTALLATIONS=false         # Revoke other installations

# Base Network Configuration
BASE_RPC_URL=https://mainnet.base.org
EVMAUTH_FACTORY_ADDRESS=0xa8830A603aE5143a1f8BAA46e28C36e4765EC754
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# MegaPot Lottery Configuration - Testnet (Active)
MEGAPOT_CONTRACT_ADDRESS=0x6f03c7BCaDAdBf5E6F5900DA3d56AdD8FbDac5De  # Base Sepolia Testnet
MEGAPOT_USDC_ADDRESS=0xA4253E7C13525287C56550b8708100f93E60509f      # MPUSDC (Test Token)
MEGAPOT_REFERRER_ADDRESS=                   # Optional: custom referrer address (defaults to agent wallet)

# MegaPot Lottery Configuration - Mainnet (Comment out testnet above and uncomment these for production)
# MEGAPOT_CONTRACT_ADDRESS=0xbEDd4F2beBE9E3E636161E644759f3cbe3d51B95  # Base Mainnet Production
# MEGAPOT_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913     # USDC (Production)

# MegaPot Data API (Optional - enables real-time jackpot stats and user history)
# Get your API key by contacting the MegaPot team: https://docs.megapot.io/developers/developer-reference/megapot-api
MEGAPOT_DATA_API_KEY=your_megapot_data_api_key_here

# IPFS & Metadata (Optional)
PINATA_JWT=your_pinata_jwt_token
IPFS_GATEWAY=https://gateway.pinata.cloud
DEFAULT_NFT_IMAGE_HASH=bafkreies7jntbufslrlq7524ahrrtjmwssarm3ni3zmbg7nmo6c4toqxne

# Neynar API for User Mentions (Optional - for enhanced UX with @ mentions)
NEYNAR_API_KEY=your_neynar_api_key_here
# Get your API key from: https://docs.neynar.com/reference/getting-started

# Indexer Integration (Optional)
INDEXER_URL=https://8a90b832-68f2-4bb7-a355-f8a0e65cba16.squids.live/xmtp-indexer@v5/api/graphql
