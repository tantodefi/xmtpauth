# XMTP Configuration (using agent-sdk environment variables)
XMTP_WALLET_KEY=0x...                          # Agent's private key
XMTP_DB_ENCRYPTION_KEY=...                     # Database encryption key  
XMTP_ENV=dev                                   # dev, production
XMTP_DB_PATH=.data/xmtp                       # Optional: database path (in-memory if not set)
XMTP_FORCE_DEBUG=false                        # Enable debug logging
XMTP_FORCE_REVOKE_INSTALLATIONS=false         # Revoke other installations

